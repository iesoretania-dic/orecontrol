{% extends 'admin/layout.html.twig' %}

{% block admin_content %}
    <h1 class="h3 mb-3">{{ is_new ? 'Nuevo docente' : 'Editar docente' }}</h1>

    {% for error in errors %}
        <div class="alert alert-danger">{{ error }}</div>
    {% endfor %}

    <form method="post" class="col-12 col-md-6">
        <input type="hidden" name="_token" value="{{ csrf_token('person_form') }}">

        <div class="mb-3">
            <label for="username" class="form-label">Usuario</label>
            <input type="text" id="username" name="username" value="{{ person.username }}" class="form-control" required>
        </div>

        <div class="mb-3">
            <label for="level" class="form-label">Nivel</label>
            <input type="number" id="level" name="level" value="{{ person.level ?? 0 }}" class="form-control">
        </div>

        <div class="form-check mb-2">
            <input type="checkbox" id="manager" name="manager" value="1" class="form-check-input" {{ person.manager ? 'checked' }}>
            <label for="manager" class="form-check-label">Administrador</label>
        </div>

        <div class="form-check mb-2">
            <input type="checkbox" id="active" name="active" value="1" class="form-check-input" {{ person.active or is_new ? 'checked' }}>
            <label for="active" class="form-check-label">Activo</label>
        </div>

        <div class="form-check mb-3">
            <input type="checkbox" id="external" name="external" value="1" class="form-check-input" {{ person.external ? 'checked' }}>
            <label for="external" class="form-check-label">Usuario iSéneca (sin contraseña local)</label>
        </div>

        <div class="mb-3">
            <label for="password" class="form-label">Contraseña{{ is_new ? '' : ' (dejar en blanco para no cambiarla)' }}</label>
            <input type="password" id="password" name="password" class="form-control" autocomplete="new-password">
            <div class="form-text">Se ignora si el docente es de tipo iSéneca.</div>
        </div>

        <button type="submit" class="btn btn-dark">Guardar</button>
        <a href="{{ path('admin_person_index') }}" class="btn btn-link">Cancelar</a>
    </form>
{% endblock %}
