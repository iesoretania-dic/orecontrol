{% extends 'admin/layout.html.twig' %}

{% block admin_content %}
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h1 class="h3 mb-0">Docentes</h1>
        <a href="{{ path('admin_person_new') }}" class="btn btn-dark">Nuevo docente</a>
    </div>

    <table class="table table-striped align-middle">
        <thead>
            <tr>
                <th>Usuario</th>
                <th>Nivel</th>
                <th>Administrador</th>
                <th>Autenticación</th>
                <th>Estado</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            {% for person in persons %}
                <tr>
                    <td>{{ person.username }}</td>
                    <td>{{ person.level }}</td>
                    <td>{{ person.manager ? 'Sí' : 'No' }}</td>
                    <td>{{ person.external ? 'iSéneca' : 'Local' }}</td>
                    <td>
                        <span class="badge {{ person.active ? 'text-bg-success' : 'text-bg-secondary' }}">
                            {{ person.active ? 'Activo' : 'Inactivo' }}
                        </span>
                    </td>
                    <td class="text-end">
                        <a href="{{ path('admin_person_edit', {id: person.id}) }}" class="btn btn-sm btn-outline-secondary">Editar</a>
                        <form action="{{ path(person.active ? 'admin_person_deactivate' : 'admin_person_activate', {id: person.id}) }}" method="post" class="d-inline">
                            <input type="hidden" name="_token" value="{{ csrf_token('toggle_person') }}">
                            <button type="submit" class="btn btn-sm btn-outline-{{ person.active ? 'danger' : 'success' }}">
                                {{ person.active ? 'Desactivar' : 'Activar' }}
                            </button>
                        </form>
                    </td>
                </tr>
            {% else %}
                <tr>
                    <td colspan="6" class="text-center text-body-secondary">No hay docentes dados de alta todavía.</td>
                </tr>
            {% endfor %}
        </tbody>
    </table>
{% endblock %}
