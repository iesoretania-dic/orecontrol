{% extends 'admin/layout.html.twig' %}

{% block admin_content %}
    <h1 class="app-page-title h4 mb-3">{{ ux_icon('bi:file-earmark-arrow-up') }} Importar docentes desde CSV</h1>

    <div class="alert alert-info d-flex align-items-center gap-2">
        {{ ux_icon('bi:info-circle-fill', {class: 'flex-shrink-0'}) }}
        <span>
            El fichero debe tener una columna <code>Usuario IdEA</code> con el usuario de cada docente.
            Si además tiene una columna <code>Empleado/a</code> con el formato «Apellidos, Nombre», se
            usa para rellenar el nombre para mostrar. Los que no existan todavía se crean con
            autenticación <strong>iSéneca</strong> (sin contraseña local); los que ya existan no se
            modifican.
        </span>
    </div>

    <div class="app-surface p-4 col-12 col-md-7 col-lg-6">
        <form method="post" enctype="multipart/form-data">
            <input type="hidden" name="_token" value="{{ csrf_token('import_persons') }}">

            <div class="mb-3">
                <label for="csv" class="form-label">Fichero CSV</label>
                <input type="file" id="csv" name="csv" accept=".csv,text/csv" class="form-control" required>
            </div>

            <div class="d-flex gap-2">
                <button type="submit" class="btn btn-dark d-inline-flex align-items-center gap-2">
                    {{ ux_icon('bi:upload') }} Importar
                </button>
                <a href="{{ path('admin_person_index') }}" class="btn btn-link">Cancelar</a>
            </div>
        </form>
    </div>
{% endblock %}
