{% extends 'admin/layout.html.twig' %}

{% block admin_content %}
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
        <h1 class="app-page-title h4 mb-0">{{ ux_icon('bi:list-ul') }} Miembros de "{{ ruleGroup.name }}"</h1>
        <a href="{{ path('admin_rule_group_index') }}" class="btn btn-link">
            {{ ux_icon('bi:arrow-left') }} Volver a Reglas
        </a>
    </div>

    {% if ruleGroup.selectable %}
        <div class="alert alert-warning d-flex align-items-center gap-2">
            {{ ux_icon('bi:exclamation-triangle-fill', {class: 'flex-shrink-0'}) }}
            <span>
                Esta regla es <strong>seleccionable</strong>: sus miembros se recalculan automáticamente a
                partir de las aulas que la tengan asignada cada vez que cambie el acceso de cualquier aula
                o se ejecute una tarea programada. Cualquier cambio que hagas aquí se perderá en la
                siguiente actualización. Edita miembros a mano solo en reglas no seleccionables, de uso
                general.
            </span>
        </div>
    {% endif %}

    {% if error %}
        <div class="alert alert-danger d-flex align-items-center gap-2">
            {{ ux_icon('bi:exclamation-triangle-fill') }} {{ error }}
        </div>
    {% else %}
        <div class="app-surface p-4 col-12 col-md-7 col-lg-6">
            <form method="post">
                <input type="hidden" name="_token" value="{{ csrf_token('rule_group_members') }}">

                <div class="mb-3">
                    <label for="members" class="form-label">IPs / CIDR (una por línea)</label>
                    <textarea id="members" name="members" class="form-control" rows="12" style="font-family: monospace;">{{ members|join("\n") }}</textarea>
                    <div class="form-text">Se guarda tal cual en el controlador UniFi: una dirección IP o rango CIDR por línea.</div>
                </div>

                <div class="d-flex gap-2">
                    <button type="submit" class="btn btn-dark d-inline-flex align-items-center gap-2">
                        {{ ux_icon('bi:check-lg') }} Guardar en UniFi
                    </button>
                    <a href="{{ path('admin_rule_group_index') }}" class="btn btn-link">Cancelar</a>
                </div>
            </form>
        </div>
    {% endif %}
{% endblock %}
