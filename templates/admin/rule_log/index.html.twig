{% extends 'admin/layout.html.twig' %}

{% block admin_content %}
    <h1 class="app-page-title h4 mb-3">{{ ux_icon('bi:clock-history') }} Historial de accesos</h1>

    <div class="table-responsive-card">
        <div class="table-responsive">
            <table class="table table-striped align-middle mb-0">
                <thead>
                    <tr>
                        <th>Aula</th>
                        <th>Regla</th>
                        <th>Activado</th>
                        <th>Desactivado</th>
                    </tr>
                </thead>
                <tbody>
                    {% for log in logs %}
                        <tr>
                            <td>{{ log.network.name }}</td>
                            <td>{{ log.ruleGroup ? log.ruleGroup.name : 'Acceso completo' }}</td>
                            <td>
                                {{ log.createdAt|date('d/m/Y H:i') }}<br>
                                <span class="text-body-secondary small d-inline-flex align-items-center gap-1">
                                    {% if log.createdBy %}
                                        {{ ux_icon('bi:person-fill') }} {{ log.createdBy.displayLabel }}
                                    {% elseif log.createdViaScheduledTask %}
                                        {{ ux_icon('bi:calendar2-week-fill') }} Tarea programada{{ log.createdScheduledTask ? ' "' ~ log.createdScheduledTask.name ~ '"' : ' (eliminada)' }}
                                    {% else %}
                                        {{ ux_icon('bi:hdd-network-fill') }} IP autorizada{{ log.createdIp ? ' (' ~ log.createdIp ~ ')' : '' }}
                                    {% endif %}
                                </span>
                            </td>
                            <td>
                                {% if log.deletedAt %}
                                    {{ log.deletedAt|date('d/m/Y H:i') }}<br>
                                    <span class="text-body-secondary small d-inline-flex align-items-center gap-1">
                                        {% if log.deletedBy %}
                                            {{ ux_icon('bi:person-fill') }} {{ log.deletedBy.displayLabel }}
                                        {% elseif log.deletedViaScheduledTask %}
                                            {{ ux_icon('bi:calendar2-week-fill') }} Tarea programada{{ log.deletedScheduledTask ? ' "' ~ log.deletedScheduledTask.name ~ '"' : ' (eliminada)' }}
                                        {% else %}
                                            {{ ux_icon('bi:hdd-network-fill') }} IP autorizada{{ log.deletedIp ? ' (' ~ log.deletedIp ~ ')' : '' }}
                                        {% endif %}
                                    </span>
                                {% else %}
                                    <span class="badge text-bg-success d-inline-flex align-items-center gap-1">{{ ux_icon('bi:check-circle-fill') }} Vigente</span>
                                {% endif %}
                            </td>
                        </tr>
                    {% else %}
                        <tr>
                            <td colspan="4" class="text-center text-body-secondary py-4">Todavía no hay cambios registrados.</td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    </div>
{% endblock %}
