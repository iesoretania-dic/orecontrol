{% extends 'admin/layout.html.twig' %}

{% block admin_content %}
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h1 class="h3 mb-0">Tareas programadas</h1>
        <a href="{{ path('admin_scheduled_task_new') }}" class="btn btn-dark">Nueva tarea</a>
    </div>

    <table class="table table-striped align-middle">
        <thead>
            <tr>
                <th>Nombre</th>
                <th>Aulas</th>
                <th>Acción</th>
                <th>Días</th>
                <th>Hora</th>
                <th>Estado</th>
                <th>Última ejecución</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            {% for task in tasks %}
                <tr>
                    <td>{{ task.name }}</td>
                    <td>{{ task.allNetworks ? 'Todas' : task.networks|map(n => n.name)|join(', ') }}</td>
                    <td>{{ task.targetRuleGroup ? task.targetRuleGroup.name : 'Acceso completo' }}</td>
                    <td>{{ task.weekdays|map(d => weekday_labels[d])|join(', ') }}</td>
                    <td>{{ task.time ? task.time|date('H:i') : '' }}</td>
                    <td>
                        <span class="badge {{ task.enabled ? 'text-bg-success' : 'text-bg-secondary' }}">
                            {{ task.enabled ? 'Activa' : 'Inactiva' }}
                        </span>
                    </td>
                    <td>{{ task.lastRunAt ? task.lastRunAt|date('d/m/Y H:i') : 'Nunca' }}</td>
                    <td class="text-end text-nowrap">
                        <a href="{{ path('admin_scheduled_task_edit', {id: task.id}) }}" class="btn btn-sm btn-outline-secondary">Editar</a>
                        <form action="{{ path(task.enabled ? 'admin_scheduled_task_deactivate' : 'admin_scheduled_task_activate', {id: task.id}) }}" method="post" class="d-inline">
                            <input type="hidden" name="_token" value="{{ csrf_token('toggle_scheduled_task') }}">
                            <button type="submit" class="btn btn-sm btn-outline-{{ task.enabled ? 'danger' : 'success' }}">
                                {{ task.enabled ? 'Desactivar' : 'Activar' }}
                            </button>
                        </form>
                        <form action="{{ path('admin_scheduled_task_delete', {id: task.id}) }}" method="post" class="d-inline" onsubmit="return confirm('¿Eliminar esta tarea?');">
                            <input type="hidden" name="_token" value="{{ csrf_token('delete_scheduled_task') }}">
                            <button type="submit" class="btn btn-sm btn-outline-danger">Eliminar</button>
                        </form>
                    </td>
                </tr>
            {% else %}
                <tr>
                    <td colspan="8" class="text-center text-body-secondary">No hay tareas programadas todavía.</td>
                </tr>
            {% endfor %}
        </tbody>
    </table>
{% endblock %}
