{% extends 'base.html.twig' %}

{% block body %}
    <nav class="navbar navbar-expand-md app-navbar mb-4">
        <div class="container">
            <a class="navbar-brand" href="{{ path('frontpage') }}">
                {{ ux_icon('bi:router-fill') }}
                <span>{{ app_name }}</span>
            </a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNavbar" aria-controls="mainNavbar" aria-expanded="false" aria-label="Mostrar navegación">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse" id="mainNavbar">
                <ul class="navbar-nav ms-auto align-items-md-center gap-md-2 py-2 py-md-0">
                    <li class="nav-item">
                        <a class="nav-link" href="{{ path('rule_log_index') }}">
                            {{ ux_icon('bi:clock-history') }} Historial
                        </a>
                    </li>
                    {% if app.user %}
                        {% if is_granted('ROLE_ADMIN') %}
                            <li class="nav-item">
                                <a class="nav-link" href="{{ path('admin_person_index') }}">
                                    {{ ux_icon('bi:gear-fill') }} Administración
                                </a>
                            </li>
                        {% endif %}
                        <li class="nav-item">
                            <span class="nav-link text-body-secondary">
                                {{ ux_icon('bi:person-circle') }} {{ app.user.displayLabel }}
                            </span>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" href="{{ path('app_logout') }}">
                                {{ ux_icon('bi:box-arrow-right') }} Cerrar sesión
                            </a>
                        </li>
                    {% else %}
                        <li class="nav-item">
                            <a class="nav-link" href="{{ path('app_login') }}">
                                {{ ux_icon('bi:person-badge') }} Acceso de docentes
                            </a>
                        </li>
                    {% endif %}
                </ul>
            </div>
        </div>
    </nav>
    <div class="container pb-5">
    {% block content %}{% endblock %}
    </div>
{% endblock %}
