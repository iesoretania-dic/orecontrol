<div{{ attributes.defaults({'data-poll': 'delay(4000)|$render'}) }}>
    {% if not this.networks %}
        <div class="app-surface p-4 text-center">
            {{ ux_icon('bi:wifi-off', {class: 'fs-1 text-body-secondary mb-2'}) }}
            <h2 class="h5 mb-0">No tiene acceso al control de ningún aula.</h2>
            <p class="text-body-secondary small mb-0">IP: {{ this.ip }}</p>
        </div>
    {% else %}
        <div class="row row-cols-1 row-cols-sm-2 row-cols-md-3 row-cols-lg-4 row-cols-xl-5 g-3">
            {% for network in this.networks %}
                {% set managed = network in this.networksManaged %}
                {% set restricted = network.ruleGroup is not null %}
                <div class="col">
                    <div class="card h-100 network-card {{ restricted ? 'network-card--restricted' : 'network-card--open' }} {{ managed ? 'network-card--managed' : '' }}">
                        <div class="card-header d-flex justify-content-between align-items-center">
                            <h2 class="h6 mb-0">{{ network.name }}</h2>
                            {{ ux_icon(restricted ? 'bi:wifi-off' : 'bi:wifi', {class: 'network-card__status-icon'}) }}
                        </div>
                        <div class="card-body">
                            {% if managed %}
                                <form action="{{ path('frontpage_update', {'id': network.id}) }}" method="post" class="d-grid gap-2">
                                    <input type="hidden" name="_token" value="{{ csrf_token('network_update') }}">
                                    <button type="submit" class="btn btn-{{ network.ruleGroup ? 'outline-success' : 'success' }} d-flex align-items-center gap-2" name="rule_group">
                                        {{ ux_icon('bi:wifi') }} Acceso completo
                                    </button>
                                    {% for rule_group in this.ruleGroups %}
                                        {% set active = network.ruleGroup and network.ruleGroup == rule_group %}
                                        <button type="submit" class="btn btn-{{ active ? 'warning' : 'outline-warning' }} d-flex align-items-center gap-2" name="rule_group" value="{{ rule_group.id }}">
                                            {{ ux_icon('bi:shield-lock') }} {{ rule_group.name }}
                                        </button>
                                    {% endfor %}
                                </form>
                            {% else %}
                                <span class="badge {{ restricted ? 'text-bg-warning' : 'text-bg-success' }} d-inline-flex align-items-center gap-1">
                                    {{ ux_icon(restricted ? 'bi:shield-lock' : 'bi:wifi') }}
                                    {{ network.ruleGroup ? network.ruleGroup.name : 'Acceso completo' }}
                                </span>
                            {% endif %}
                        </div>
                        <div class="card-footer d-flex justify-content-between align-items-center gap-2 small">
                            <span>
                                {% if network.enabledAt %}
                                    {{ ux_icon('bi:clock') }} Activado {{ network.enabledAt|ago }}
                                {% endif %}
                            </span>
                            {% if managed %}
                                <a href="{{ path('rule_log_index', {network: network.id}) }}" class="link-secondary text-decoration-none" title="Historial" aria-label="Historial">
                                    {{ ux_icon('bi:clock-history') }}
                                </a>
                            {% endif %}
                        </div>
                    </div>
                </div>
            {% endfor %}
        </div>
    {% endif %}
</div>
