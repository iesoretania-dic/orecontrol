<div{{ attributes.defaults({'data-poll': 'delay(4000)|$render'}) }}>
    {% if not this.networks %}
        <h2>No tiene acceso al control de ningún aula. (IP: {{ this.ip }})</h2>
    {% else %}
        <div class="row row-cols-1 row-cols-md-5 g-4">
            {% for network in this.networks %}
                {% set managed = network in this.networksManaged %}
                {% if managed %}
                    {% set class = network.ruleGroup ? 'text-bg-warning' : 'text-bg-success' %}
                {% else %}
                    {% set class = network.ruleGroup ? 'border-warning' : 'border-success' %}
                {% endif %}
                <div class="col">
                    <div class="card {{ class }} h-100 network-group">
                        <div class="card-header"><h2>{{ network.name }}</h2></div>
                        <div class="card-body">
                            {% if managed %}
                                <form action="{{ path('frontpage_update', {'id': network.id}) }}" method="post">
                                    <input type="hidden" name="_token" value="{{ csrf_token('network_update') }}">
                                    <button type="submit" class="btn btn-{{ network.ruleGroup ? 'light' : 'dark' }} btn w-100 mb-2" name="rule_group">Acceso completo</button>
                                    {% for rule_group in this.ruleGroups %}
                                        {% if not network.ruleGroup %}
                                            {% set active = false %}
                                        {% else %}
                                            {% set active = network.ruleGroup == rule_group %}
                                        {% endif %}
                                        <button type="submit" class="btn btn-{{ not active ? 'light' : 'dark' }} btn w-100 mb-2" name="rule_group" value="{{ rule_group.id }}">{{ rule_group.name }}</button>
                                    {% endfor %}
                                </form>
                            {% else %}
                                {% if network.ruleGroup %}
                                    <h4 class="card-text">{{ network.ruleGroup.name }}</h4>
                                {% else %}
                                    <h4 class="card-text">Acceso completo</h4>
                                {% endif %}
                            {% endif %}
                        </div>
                        <div class="card-footer d-flex justify-content-between align-items-center gap-2">
                            <span>
                                {% if network.enabledAt %}
                                    Activado {{ network.enabledAt|ago }}
                                {% endif %}
                            </span>
                            <a href="{{ path('rule_log_index', {network: network.id}) }}" class="{{ managed ? 'link-light' : 'link-secondary' }}">Historial</a>
                        </div>
                    </div>
                </div>
            {% endfor %}
        </div>
    {% endif %}
</div>
