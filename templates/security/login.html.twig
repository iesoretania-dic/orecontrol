{% extends 'layout.html.twig' %}

{% block content %}
    <div class="row justify-content-center">
        <div class="col-12 col-sm-8 col-md-5 col-lg-4">
            <div class="app-surface p-4 mt-4">
                <div class="text-center mb-3">
                    <div class="d-inline-flex align-items-center justify-content-center rounded-circle bg-body-secondary mb-2" style="width: 3.5rem; height: 3.5rem;">
                        {{ ux_icon('bi:person-badge', {class: 'fs-3', style: 'color: var(--app-brand);'}) }}
                    </div>
                    <h1 class="h4 mb-0">Acceso de docentes</h1>
                </div>

                {% if error %}
                    <div class="alert alert-danger d-flex align-items-center gap-2">
                        {{ ux_icon('bi:exclamation-triangle-fill') }} {{ error.messageKey|trans(error.messageData, 'security') }}
                    </div>
                {% endif %}

                <form method="post">
                    <div class="mb-3">
                        <label for="username" class="form-label">Usuario</label>
                        <div class="input-group">
                            <span class="input-group-text">{{ ux_icon('bi:person-fill') }}</span>
                            <input type="text" id="username" name="_username" value="{{ last_username }}" class="form-control" autocomplete="username" required autofocus>
                        </div>
                    </div>
                    <div class="mb-3">
                        <label for="password" class="form-label">Contraseña</label>
                        <div class="input-group">
                            <span class="input-group-text">{{ ux_icon('bi:lock-fill') }}</span>
                            <input type="password" id="password" name="_password" class="form-control" autocomplete="current-password" required>
                        </div>
                    </div>
                    <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">
                    <button class="btn btn-dark w-100 d-flex align-items-center justify-content-center gap-2" type="submit">
                        {{ ux_icon('bi:box-arrow-in-right') }} Entrar
                    </button>
                </form>
            </div>
        </div>
    </div>
{% endblock %}
